{
  "expo": {
    "name": "MeuTreino+",
    "slug": "meutreino-plus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meutreino",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "plus.meutreino.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "plus.meutreino.app",
      "adaptiveIcon": {
        "backgroundColor": "#134E4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#134E4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "O MeuTreino+ acessa as fotos escolhidas por você para seu perfil e seus equipamentos.",
          "cameraPermission": "O MeuTreino+ usa a câmera quando você escolhe fotografar seus equipamentos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
