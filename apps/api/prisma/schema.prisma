/// lockedAt freezes the recorded result. planSnapshot is the ficha photograph taken at start.
model WorkoutSession {
  id               String        @id @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  workoutPlanId    String?       @map("workout_plan_id") @db.Uuid
  planNameSnapshot String        @map("plan_name_snapshot") @db.VarChar(120)
  planVersion      Int?          @map("plan_version")
  planSnapshot     Json          @map("plan_snapshot")
  gymId            String?       @map("gym_id") @db.Uuid
  gymName          String?       @map("gym_name") @db.VarChar(120)
  status           SessionStatus @default(in_progress)
  startedAt        DateTime      @map("started_at") @db.Timestamptz(3)
  pausedAt         DateTime?     @map("paused_at") @db.Timestamptz(3)
  endedAt          DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSeconds  Int?          @map("duration_seconds")
  elapsedSeconds   Int?          @map("elapsed_seconds")
  notes            String?       @db.Text
  lockedAt         DateTime?     @map("locked_at") @db.Timestamptz(3)
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  workoutPlan WorkoutPlan?               @relation(fields: [workoutPlanId], references: [id], onDelete: Restrict)
  gym         Gym?                       @relation(fields: [gymId], references: [id], onDelete: Restrict)
  exercises   ExerciseSession[]
  timeEvents  SessionTimeEvent[]
  resolutions WorkoutSessionResolution[]
  variants    WorkoutSessionVariant[]
  conflicts   WorkoutSessionConflict[]

  @@index([userId, startedAt])
  @@index([workoutPlanId])
  @@map("workout_sessions")
  @@schema("meutreino")
}

model SessionTimeEvent {
  id                  String          @id @db.Uuid
  workoutSessionId    String          @map("workout_session_id") @db.Uuid
  exerciseSessionId   String?         @map("exercise_session_id") @db.Uuid
  kind                SessionTimeKind
  occurredAt          DateTime        @map("occurred_at") @db.Timestamptz(3)
  restDurationSeconds Int?            @map("rest_duration_seconds")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  workoutSession  WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Restrict)
  exerciseSession ExerciseSession? @relation(fields: [exerciseSessionId], references: [id], onDelete: Restrict)

  @@index([workoutSessionId, occurredAt])
  @@map("session_time_events")
  @@schema("meutreino")
}

model WorkoutSessionConflict {
  id               String                @id @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  workoutSessionId String                @map("workout_session_id") @db.Uuid
  baseVersion      Int?                  @map("base_version")
  payload          Json
  status           SessionConflictStatus @default(open)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Restrict)

  resolution WorkoutSessionResolution?

  @@index([userId, status])
  @@map("workout_session_conflicts")
  @@schema("meutreino")
}

model ExerciseSession {
  id                   String                @id @db.Uuid
  workoutSessionId     String                @map("workout_session_id") @db.Uuid
  planExerciseId       String?               @map("plan_exercise_id") @db.Uuid
  exerciseId           String                @map("exercise_id") @db.Uuid
  exerciseNameSnapshot String                @map("exercise_name_snapshot") @db.VarChar(160)
  orderIndex           Int                   @map("order_index")
  status               ExerciseSessionStatus @default(pending)
  startedAt            DateTime?             @map("started_at") @db.Timestamptz(3)
  endedAt              DateTime?             @map("ended_at") @db.Timestamptz(3)
  skipReason           String?               @map("skip_reason") @db.VarChar(200)
  plannedRestSeconds   Int?                  @map("planned_rest_seconds")
  gymName              String?               @map("gym_name") @db.VarChar(120)
  equipmentName        String?               @map("equipment_name") @db.VarChar(160)
  machineNumber        String?               @map("machine_number") @db.VarChar(40)

  workoutSession WorkoutSession       @relation(fields: [workoutSessionId], references: [id], onDelete: Restrict)
  planExercise   WorkoutPlanExercise? @relation(fields: [planExerciseId], references: [id], onDelete: SetNull)
  exercise       Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets           PerformedSet[]
  feedback       ExerciseFeedback?
  timeEvents     SessionTimeEvent[]

  @@unique([workoutSessionId, orderIndex])
  @@index([exerciseId])
  @@map("exercise_sessions")
  @@schema("meutreino")
}

/// Immutable. A mistake is recorded in performed_set_corrections.
model PerformedSet {
  id                       String              @id @db.Uuid
  exerciseSessionId        String              @map("exercise_session_id") @db.Uuid
  plannedSetId             String?             @map("planned_set_id") @db.Uuid
  setIndex                 Int                 @map("set_index")
  outcome                  PerformedSetOutcome @default(completed)
  plannedRepetitions       Int?                @map("planned_repetitions")
  plannedLoad              Decimal?            @map("planned_load") @db.Decimal(7, 2)
  plannedLoadUnit          WeightUnit?         @map("planned_load_unit")
  plannedLoadKg            Decimal?            @map("planned_load_kg") @db.Decimal(7, 2)
  plannedDurationSeconds   Int?                @map("planned_duration_seconds")
  performedRepetitions     Int?                @map("performed_repetitions")
  performedLoad            Decimal?            @map("performed_load") @db.Decimal(7, 2)
  performedLoadUnit        WeightUnit?         @map("performed_load_unit")
  performedLoadKg          Decimal?            @map("performed_load_kg") @db.Decimal(7, 2)
  performedDurationSeconds Int?                @map("performed_duration_seconds")
  notes                    String?             @db.VarChar(500)
  completedAt              DateTime            @map("completed_at") @db.Timestamptz(3)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  exerciseSession ExerciseSession          @relation(fields: [exerciseSessionId], references: [id], onDelete: Restrict)
  corrections     PerformedSetCorrection[]

  @@unique([exerciseSessionId, setIndex])
  @@map("performed_sets")
  @@schema("meutreino")
}

model PerformedSetCorrection {
  id                       String    @id @default(uuid()) @db.Uuid
  performedSetId           String    @map("performed_set_id") @db.Uuid
  correctedByUserId        String    @map("corrected_by_user_id") @db.Uuid
  performedRepetitions     Int?      @map("performed_repetitions")
  performedLoad            Decimal?  @map("performed_load") @db.Decimal(7, 2)
  performedLoadUnit        WeightUnit? @map("performed_load_unit")
  performedLoadKg          Decimal?  @map("performed_load_kg") @db.Decimal(7, 2)
  performedDurationSeconds Int?      @map("performed_duration_seconds")
  voided                   Boolean   @default(false)
  reason                   String    @db.VarChar(300)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  performedSet PerformedSet @relation(fields: [performedSetId], references: [id], onDelete: Restrict)
  correctedBy  User         @relation(fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@index([performedSetId, createdAt])
  @@map("performed_set_corrections")
  @@schema("meutreino")
}

/// Subjective record supplied by the user. It is not a clinical assessment.
model ExerciseFeedback {
  id                 String   @id @db.Uuid
  exerciseSessionId  String   @unique @map("exercise_session_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  perceivedLevel     Int?     @map("perceived_level") @db.SmallInt
  comment            String?  @db.Text
  discomfortReported Boolean  @default(false) @map("discomfort_reported")
  discomfortNote     String?  @map("discomfort_note") @db.Text
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  exerciseSession ExerciseSession            @relation(fields: [exerciseSessionId], references: [id], onDelete: Restrict)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  revisions       ExerciseFeedbackRevision[]

  @@index([userId])
  @@map("exercise_feedback")
  @@schema("meutreino")
}

model ProfessionalProfile {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @unique @map("user_id") @db.Uuid
  displayName String             @map("display_name") @db.VarChar(120)
  status      ProfessionalStatus @default(draft)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("professional_profiles")
  @@schema("meutreino")
}

model StudentProfessionalLink {
  id                 String     @id @default(uuid()) @db.Uuid
  studentUserId      String     @map("student_user_id") @db.Uuid
  professionalUserId String     @map("professional_user_id") @db.Uuid
  invitedByUserId    String     @map("invited_by_user_id") @db.Uuid
