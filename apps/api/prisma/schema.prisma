  @@unique([resolutionId, origin])
  @@index([workoutSessionId])
  @@map("workout_session_variants")
  @@schema("meutreino")
}

model ExerciseFeedbackRevision {
  feedbackId String           @map("feedback_id") @db.Uuid
  version    Int
  payload    Json
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  feedback   ExerciseFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)

  @@id([feedbackId, version])
  @@map("exercise_feedback_revisions")
  @@schema("meutreino")
}


model PlanRevisionOrigin {
  id          String   @id @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  version     Int
  requestHash String   @map("request_hash") @db.VarChar(64)
  parentId    String?  @map("parent_id") @db.Uuid
  operationId String   @unique @map("operation_id") @db.Uuid
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  plan      WorkoutPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  operation SyncOperation       @relation(fields: [operationId], references: [id], onDelete: Restrict)
