  @@map("link_permissions")
  @@schema("meutreino")
}

/// Trial, renewal, and expiry originate from Apple or Google. There is no internal trial clock.
model Subscription {
  id                         String               @id @default(uuid()) @db.Uuid
  userId                     String               @map("user_id") @db.Uuid
  provider                   SubscriptionProvider
  productCode                String               @map("product_code") @db.VarChar(120)
  status                     SubscriptionStatus
  environment                BillingEnvironment
  storeOriginalTransactionId String               @map("store_original_transaction_id")
  currentPeriodStart         DateTime             @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd           DateTime             @map("current_period_end") @db.Timestamptz(3)
  willRenew                  Boolean              @map("will_renew")
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  events SubscriptionEvent[]

  @@unique([provider, storeOriginalTransactionId])
  @@index([userId, status])
  @@map("subscriptions")
  @@schema("meutreino")
}

model SubscriptionEvent {
  id              String               @id @default(uuid()) @db.Uuid
  subscriptionId  String?              @map("subscription_id") @db.Uuid
  provider        SubscriptionProvider
  providerEventId String               @map("provider_event_id")
  eventType       String               @map("event_type") @db.VarChar(120)
  payloadHash     String               @map("payload_hash")
  receivedAt      DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([subscriptionId])
  @@map("subscription_events")
  @@schema("meutreino")
}

/// Detached from users so a store transaction id can outlive account deletion.
model BillingRetentionRecord {
  id                         String               @id @default(uuid()) @db.Uuid
  formerUserId               String               @map("former_user_id") @db.Uuid
  provider                   SubscriptionProvider
  storeOriginalTransactionId String               @map("store_original_transaction_id")
  retainUntil                DateTime             @map("retain_until") @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([retainUntil])
  @@map("billing_retention_records")
  @@schema("meutreino")
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  installationId String         @map("installation_id") @db.Uuid
  platform       DevicePlatform
  appVersion     String         @map("app_version") @db.VarChar(40)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions       AuthSession[]
  syncOperations SyncOperation[]

  @@unique([userId, installationId])
  @@index([userId])
  @@map("devices")
  @@schema("meutreino")
}

/// Server receipt of a sync attempt. The payload itself stays on the entity tables and on the device.
model SyncOperation {
  id             String              @id @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  deviceId       String              @map("device_id") @db.Uuid
  entityType     SyncEntityType      @map("entity_type")
  entityId       String              @map("entity_id") @db.Uuid
  operation      SyncOperationType
  idempotencyKey String              @unique @map("idempotency_key")
  payloadHash    String              @map("payload_hash")
  baseVersion    Int?                @map("base_version")
  status         SyncOperationStatus @default(pending)
  conflictCode   String?             @map("conflict_code") @db.VarChar(80)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt      DateTime?           @map("applied_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([entityType, entityId])
  @@map("sync_operations")
  @@schema("meutreino")
  revisionOrigin PlanRevisionOrigin?

}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
  @@schema("meutreino")
}

/// Single-use email confirmation. Only the SHA-256 of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
  @@schema("meutreino")
}

/// Single-use password recovery. Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
  @@schema("meutreino")
}

/// Confirms a new address before it replaces the current one.
model EmailChangeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  nextEmail String    @map("next_email") @db.Citext
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("email_change_tokens")
  @@schema("meutreino")
}

/// Append-only security trail. Payloads must not contain tokens, passwords, or raw e-mail addresses.
model SecurityAuditEvent {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String?              @map("user_id") @db.Uuid
  eventType   String               @map("event_type") @db.VarChar(80)
  outcome     SecurityAuditOutcome
  subjectHash String?              @map("subject_hash")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_audit_events")
  @@schema("meutreino")
}

model WorkoutSessionResolution {
  id               String                  @id @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  conflictId       String                  @unique @map("conflict_id") @db.Uuid
  workoutSessionId String                  @map("workout_session_id") @db.Uuid
  choice           String                  @db.Text
  localRevision    Int                     @map("local_revision")
  expectedVersion  Int                     @map("expected_version")
  requestHash      String                  @map("request_hash") @db.VarChar(64)
  result           Json
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  conflict         WorkoutSessionConflict  @relation(fields: [conflictId], references: [id], onDelete: Restrict)
  workoutSession   WorkoutSession          @relation(fields: [workoutSessionId], references: [id], onDelete: Restrict)
  variants         WorkoutSessionVariant[]

  @@index([userId])
  @@map("workout_session_resolutions")
  @@schema("meutreino")
}

model WorkoutSessionVariant {
  id               String                   @id @db.Uuid
  resolutionId     String                   @map("resolution_id") @db.Uuid
  workoutSessionId String                   @map("workout_session_id") @db.Uuid
