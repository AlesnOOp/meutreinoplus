# MeuTreino+ — variáveis de desenvolvimento local.
# Copie este arquivo para apps/api/.env
# Copie apenas EXPO_PUBLIC_API_URL para apps/mobile/.env
# Estes valores são padrões locais. Não são segredos de produção e não devem ser reutilizados fora da máquina de desenvolvimento.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://meutreino:meutreino@localhost:5432/meutreino
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info

# Segredo só de desenvolvimento. Produção precisa de outro valor, com 32 caracteres ou mais.
AUTH_ACCESS_TOKEN_SECRET=development-only-access-token-secret-32
EMAIL_DELIVERY=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=MeuTreino+ <nao-responda@meutreino.local>
APP_LINK_BASE=meutreino://
APPLE_AUDIENCES=
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=
MEDIA_ROOT=var/media
MEDIA_STORAGE=local
# Em produção, recuse a subida se o database conectado não for este. No desenvolvimento local, deixe vazio.
# EXPECTED_DATABASE=meutreinodb
EXPORT_ROOT=var/exports

# Endereço público da API embutido no aplicativo. Não é um segredo.
# Simulador iOS: http://localhost:3000
# Emulador Android: http://10.0.2.2:3000
# Aparelho físico: use o IP da máquina na rede local.
EXPO_PUBLIC_API_URL=http://localhost:3000
